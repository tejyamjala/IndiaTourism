# INDIVYA future integration placeholders
# Copy to .env.local for local development. Never commit .env.local or real credentials.

# Browser-safe public runtime values only; keep private provider keys on a backend.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_WEATHER_BASE_URL=
EXPO_PUBLIC_MAPS_BASE_URL=

# Authentication/database provider identifiers may be public where the provider permits.
EXPO_PUBLIC_AUTH_URL=
EXPO_PUBLIC_DATABASE_URL=

# Never add private API keys, passwords, JWT secrets, signing keys, or service-role keys here.
